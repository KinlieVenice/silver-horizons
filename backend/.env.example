# Copy to .env and fill in. Never commit .env.
# Google Cloud Console → APIs & Services → Credentials → OAuth client ID (type: Web application).
# Authorized redirect URI for local dev: http://localhost:5199/auth/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Random secret that signs the session cookie: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=
# Only verified Google accounts on this domain can sign in
ALLOWED_DOMAIN=fireflyelectric.com
# Local dev runs on plain http; keep true anywhere served over https
COOKIE_SECURE=false
# Where to land after sign-in when the frontend is on another origin (empty = same origin)
FRONTEND_URL=
# Set only when the callback URL can't be derived from the request (e.g. behind a proxy)
OAUTH_REDIRECT_URI=
